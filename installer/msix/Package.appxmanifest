<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap rescap">
  <Identity Name="LyricConnector.StoreIdentityPlaceholder"
            Publisher="CN=ReplaceWithPartnerCenterPublisher"
            Version="0.1.0.0"
            ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>Lyric Connector</DisplayName>
    <PublisherDisplayName>Replace with Partner Center publisher name</PublisherDisplayName>
    <Description>Show synchronized lyrics for music playing on a paired iPhone.</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop"
                        MinVersion="10.0.18362.0"
                        MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Resources>
    <Resource Language="en-US" />
  </Resources>
  <Applications>
    <Application Id="LyricConnector"
                 Executable="LyricConnector.exe"
                 EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="Lyric Connector"
                          Description="Show synchronized lyrics for music playing on a paired iPhone."
                          Square150x150Logo="Assets\Square150x150Logo.png"
                          Square44x44Logo="Assets\Square44x44Logo.png"
                          BackgroundColor="#FFFFFF" />
    </Application>
  </Applications>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <DeviceCapability Name="bluetooth" />
  </Capabilities>
</Package>
